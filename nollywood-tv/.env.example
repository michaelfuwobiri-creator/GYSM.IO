# Copy to .env and fill in. Leave VITE_THIRDWEB_CLIENT_ID empty for demo mode.
VITE_THIRDWEB_CLIENT_ID=
# 8453 = Base mainnet, 84532 = Base Sepolia (testnet)
VITE_CHAIN_ID=84532
# Your thirdweb Edition Drop (ERC-1155) contract and the token ID of the pass
VITE_PASS_CONTRACT=
VITE_PASS_TOKEN_ID=0
# Public URL of pass.html (e.g. https://nollywood.example.com/pass.html)
VITE_PASS_PAGE_URL=
VITE_PASS_PRICE_LABEL=0.002 ETH / month
# Optional: catalogue API (JSON, see docs/catalog-format.md). Empty = built-in sample titles.
VITE_CATALOG_URL=
# Optional API key for it, and the header to send it in (default: Authorization: Bearer <key>).
# The key is bundled into the app, so use a read-only, catalogue-only key.
VITE_CATALOG_API_KEY=
VITE_CATALOG_API_KEY_HEADER=Authorization
# Optional: Supabase project for synced My List and watch progress (publishable key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
